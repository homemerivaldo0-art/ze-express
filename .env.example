# ============================================================
# Configuração de ambiente — copie este arquivo para `.env`
# e preencha com os valores do seu servidor (GoDaddy).
# NUNCA suba o arquivo `.env` real para repositórios públicos.
# ============================================================

# --- Banco de dados PostgreSQL (OBRIGATÓRIO) ---
# A hospedagem compartilhada da GoDaddy NÃO oferece PostgreSQL.
# Crie um banco gratuito em https://neon.tech , https://supabase.com ou
# https://railway.app (ou instale PostgreSQL no seu VPS) e cole a URL aqui:
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO?schema=public"

# --- Autenticação (OBRIGATÓRIO) ---
# Gere um segredo com:  openssl rand -base64 32
NEXTAUTH_SECRET="TROQUE_ESTE_VALOR_POR_UM_SEGREDO_ALEATORIO"

# URL pública do site (a URL final que o domínio vai responder)
NEXTAUTH_URL="https://www.seusite.com.br"

# --- Upload de imagens (opcional, recomendado) ---
# Por padrão o app usa S3 (AWS). Crie um bucket no seu console AWS e
# preencha os valores abaixo. Se deixar vazio, o upload de imagens
# pelo painel admin ficará desabilitado (o site continua funcionando).
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_BUCKET_NAME=""
AWS_FOLDER_PREFIX=""

# --- Gateway de pagamento BlackCat (opcional) ---
# Também pode ser configurado pelo painel admin (Cadastrar Gateway).
BLACKCAT_PUBLIC_KEY=""
BLACKCAT_SECRET_KEY=""

# --- IA "Brand Knowledge" (opcional) ---
# Deixe vazio para desativar. Pode usar OPENAI_API_KEY ou o provedor da plataforma.
ABACUSAI_API_KEY=""
OPENAI_API_KEY=""

# --- Cloudinary (opcional, usado em alguns recursos de imagem) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
